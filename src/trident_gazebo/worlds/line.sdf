<?xml version="1.0"?>
<!--
  Line following test world: light floor with a black 20 mm line.
  The line is a closed loop (two 2 m straights joined by 0.5 m radius half circles).
  The robot spawns at the origin on the lower straight, facing along the line.
-->
<sdf version="1.8">
  <world name="line">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Required for the D435 and the IR array cameras -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Even lighting and no shadows, so the IR readings do not depend on the robot's heading -->
    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The line is paint only: thin visual strips with no collision -->
    <model name="line">
      <static>true</static>
      <pose>0 0 0.0003 0 0 0</pose>
      <link name="link">
        <visual name="seg0">
          <pose>0.0000 0.0000 0 0 0 0.0000</pose>
          <geometry><box><size>2.0120 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg1">
          <pose>0.0000 1.0000 0 0 0 3.1416</pose>
          <geometry><box><size>2.0120 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg2">
          <pose>1.0488 0.0048 0 0 0 0.0982</pose>
          <geometry><box><size>0.1100 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg3">
          <pose>1.1444 0.0238 0 0 0 0.2945</pose>
          <geometry><box><size>0.1100 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg4">
          <pose>1.2346 0.0612 0 0 0 0.4909</pose>
          <geometry><box><size>0.1100 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg5">
          <pose>1.3157 0.1154 0 0 0 0.6872</pose>
          <geometry><box><size>0.1100 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="seg6">
          <pose>1.3846 0.1843 0 0 0 0.8836</pose>
          <geometry><box><size>0.1100 0.02 0.0004</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
