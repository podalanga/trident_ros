<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trident_bringup</name>
  <version>0.1.0</version>
  <description>Top level launch files that bring up the trident simulation, RViz and teleop</description>
  <maintainer email="145194987+podalanga@users.noreply.github.com">podalanga</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>trident_description</exec_depend>
  <exec_depend>trident_gazebo</exec_depend>
  <exec_depend>trident_teleop</exec_depend>
  <exec_depend>trident_navigation</exec_depend>
  <exec_depend>trident_mission</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
