<?xml version="1.0"?>
<!-- Gazebo Fortress (Ignition Gazebo 6) extensions for the trident robot. ROS 2 Humble. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- == surface properties == -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="castor_ball">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="gripper_drive_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="gripper_follower_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- == differential drive: /cmd_vel in, /odom + odom->base_footprint TF out == -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>${drive_accel_linear}</max_linear_acceleration>
      <min_linear_acceleration>${-drive_accel_linear}</min_linear_acceleration>
      <max_angular_acceleration>${drive_accel_angular}</max_angular_acceleration>
      <min_angular_acceleration>${-drive_accel_angular}</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- == joint states for robot_state_publisher == -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- == gripper: one position controller per jaw.
       Fortress ignores URDF <mimic>, so trident_gazebo/scripts/gripper_mimic.py takes /gripper/command (drive angle, rad)
       and publishes +angle to the drive jaw and -angle to the follower jaw. == -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_drive_joint</joint_name>
      <topic>gripper/drive_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10</p_gain>
      <cmd_max>${grip_velocity}</cmd_max>
      <cmd_min>${-grip_velocity}</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_follower_joint</joint_name>
      <topic>gripper/follower_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10</p_gain>
      <cmd_max>${grip_velocity}</cmd_max>
      <cmd_min>${-grip_velocity}</cmd_min>
    </plugin>
  </gazebo>

  <!-- == D435: RGB-D sensor on the depth origin, looking along +X.
       Depth FOV 87 deg x 58 deg. Near clip 0.1 m keeps the holder lip out of view.
       Images are stamped with the optical frame. Gazebo's own point cloud is not used: it has
       X forward but carries the same optical frame id, so the cloud is built in ROS from the
       depth image instead (see trident_gazebo sim.launch.py). == -->
  <gazebo reference="camera_depth_frame">
    <sensor name="d435" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>${d435_rate}</update_rate>
      <visualize>false</visualize>
      <topic>camera</topic>
      <ignition_frame_id>camera_depth_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>${d435_width}</width>
          <height>${d435_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.2</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- == IR line sensor array: one tiny camera per channel, looking straight down.
       ir_sensor_frame has +X toward the floor, Y across the board, Z toward the front.
       trident_gazebo/scripts/ir_array.py turns the images into one analog reading per channel. == -->
  <xacro:macro name="ir_channel" params="index">
    <gazebo reference="ir_sensor_frame">
      <sensor name="ir_ch${index}" type="camera">
        <!-- 1 mm below the board face, offset along the row -->
        <pose>0.001 ${ir_center_y + (index - (ir_channels - 1) / 2.0) * ir_pitch} ${ir_center_x} 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${ir_rate}</update_rate>
        <visualize>false</visualize>
        <topic>ir/ch${index}</topic>
        <camera>
          <!-- about an 8 mm spot on the floor from 7 mm up, like a reflectance sensor -->
          <horizontal_fov>1.0</horizontal_fov>
          <image>
            <width>8</width>
            <height>8</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.002</near>
            <far>0.1</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- xacro has no for loop, so the macro calls itself until the last channel -->
  <xacro:macro name="ir_array" params="index:=0">
    <xacro:if value="${index &lt; ir_channels}">
      <xacro:ir_channel index="${index}"/>
      <xacro:ir_array index="${index + 1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:ir_array/>

</robot>
